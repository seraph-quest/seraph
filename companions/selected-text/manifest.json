{
  "manifest_version": 3,
  "name": "Seraph deliberate selected text",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8004/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Review selected text privately"
  },
  "commands": {
    "review-selected-text": {
      "description": "Review selected ordinary DOM text",
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "incognito": "not_allowed"
}
