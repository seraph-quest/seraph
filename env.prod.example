# CPU-host production core.  The compose backend owns canonical state on this
# host; no CUDA device, model weights, local model server, or VLM wrapper is
# required to start it.
# Production bind roots must be absolute so the host and container can derive
# the same identity. Replace this deployment path before starting Compose.
HOST_DATA_ROOT_PROD=/srv/seraph/docker-data/prod

# Root directory for shared application assets.
SHARED_DATA_ROOT=./docker-data/shared

BACKEND_DATA_PATH_PROD=/srv/seraph/docker-data/prod/backend/data
BACKEND_LOGS_PATH_PROD=/srv/seraph/docker-data/prod/backend/logs

# Epic #736/#775 production target: OpenRouter is the only active inference
# gateway. The persisted model-fabric settings own consent, upstream policy,
# and finite cost ceilings; legacy provider values are not active routes.
OPENROUTER_API_KEY=your-prod-openrouter-key
LLM_API_BASE=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/z-ai/glm-5.3-flash
OPENROUTER_PROVIDER_ONLY=true
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ALLOWED_UPSTREAMS=z-ai
OPENROUTER_ZERO_DATA_RETENTION=false
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
AGENT_MAX_STEPS=10
DEBUG=false
# Host path for direct managed runs; docker-compose.prod.yaml mounts it at
# /app/data inside the backend container.
WORKSPACE_DIR=/srv/seraph/docker-data/prod/backend/data
# Container-only mount checks are enabled by Compose. Keep this host env-file
# value false so ``production_preflight.py --env-file`` reports the check as
# deferred; the container environment overrides it to true before startup.
SERAPH_PRODUCTION_MOUNT_CHECK=false
# Required by the production preflight. Set the exact mount source reported
# for /app/data in /proc/self/mountinfo (for example, /dev/mapper/seraph-data).
SERAPH_PRODUCTION_MOUNT_SOURCE=
# Generate this on the host with ``workspace_cli.py identity`` after the
# absolute BACKEND_DATA_PATH_PROD directory exists. The container compares it
# with /app/data device/inode metadata before starting the backend.
SERAPH_PRODUCTION_BIND_IDENTITY=
SANDBOX_URL=http://sandbox:8060

# Single-operator ingress boundary. Generate the PBKDF2 value with:
#   cd backend && uv run python -c 'from src.auth.service import encode_secret; print(encode_secret("REPLACE_ME"))'
# Keep the generated hash in the deployment secret store; never commit a raw
# password or expose it to the browser.
DEPLOYMENT_ENVIRONMENT=production
OPERATOR_AUTH_SECRET_HASH=
OPERATOR_AUTH_COOKIE_SECURE=true
# Keep these values exact for the public host used by the browser. For a
# private LAN deployment, replace them with the deployed LAN hostname/IP and
# its HTTPS origin, for example: seraph.lan,192.168.1.50 and
# https://seraph.lan. Host and origin checks still apply to WebSocket upgrades.
OPERATOR_AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
OPERATOR_AUTH_ALLOWED_ORIGINS=https://localhost
OPERATOR_AUTH_REVOCATION_POLL_SECONDS=2

# No local model, GPU model server, VLM wrapper, or direct-vendor fallback is a
# production dependency in this phase.
LOCAL_MODEL=
LOCAL_LLM_API_BASE=
SERAPH_VLM_MODE=
SERAPH_VLM_BASE_URL=
SERAPH_VLM_BACKEND_URL=

# Do not configure alternate provider profiles in this phase.
RUNTIME_PROFILE_PREFERENCES="chat_agent=openrouter;onboarding_agent=openrouter;orchestrator_agent=openrouter;strategist_agent=openrouter;end_of_day_goal_report=openrouter;screenshot_observation_digest=openrouter"

# Screen-analysis budgets. 0 means unlimited for caps/size; retention is days.
SCREEN_ANALYSIS_MIN_SECONDS_BETWEEN_CAPTURES=0
SCREEN_ANALYSIS_MAX_DAILY_CAPTURES=0
SCREEN_CAPTURE_ARCHIVE_RETENTION_DAYS=365
SCREEN_CAPTURE_ARCHIVE_MAX_MB=0
SCREENSHOT_FOLDER_INGEST_ENABLED=true
SCREENSHOT_FOLDER_INGEST_INTERVAL_MIN=1
SCREENSHOT_FOLDER_INGEST_LIMIT=100
SCREENSHOT_FOLDER_ANALYSIS_LIMIT=100
SCREENSHOT_FOLDER_ANALYSIS_CONCURRENCY=2
SCREENSHOT_FOLDER_ANALYSIS_JOB_TIMEOUT_SECONDS=120
# Optional: explicit OpenRouter-qualified vision model id.
# SCREEN_ANALYSIS_MODEL=openrouter/provider/model

# Local-screen end-of-day report. The report is stored in Seraph memory.
# Email delivery is off by default and, when enabled, still requires the
# preview gate to be deliberately disabled plus an allowlisted recipient.
END_OF_DAY_REPORT_ENABLED=true
END_OF_DAY_REPORT_HOUR=21
END_OF_DAY_REPORT_LLM_ENABLED=false
EMAIL_REPORTS_ENABLED=false
EMAIL_REPORTS_PREVIEW_REQUIRED=true
EMAIL_REPORTS_TO=
EMAIL_REPORTS_TO_ALLOWLIST=
EMAIL_REPORTS_FROM=
EMAIL_REPORTS_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Operator routing posture. Tune these to deployment policy and observed quality.
RUNTIME_POLICY_INTENTS="chat_agent=reasoning|tool_use;session_title_generation=fast|cheap;mcp_*=tool_use"
RUNTIME_POLICY_REQUIREMENTS="chat_agent=tool_use;mcp_*=tool_use"
RUNTIME_POLICY_SCORES="chat_agent=reasoning:5|tool_use:4;session_title_generation=fast:5|cheap:3;mcp_*=tool_use:5"
RUNTIME_MODEL_OVERRIDES=
RUNTIME_FALLBACK_OVERRIDES=
RUNTIME_MAX_COST_TIER="session_title_generation=low;mcp_*=medium"
RUNTIME_MAX_LATENCY_TIER="session_title_generation=low;mcp_*=medium"
RUNTIME_TASK_CLASS="chat_agent=interactive;mcp_*=operator_tooling"
RUNTIME_MAX_BUDGET_CLASS="session_title_generation=low;mcp_*=medium"

# Provider tags are routing metadata for policy, fallback, and audit surfaces.
# They do not assert equivalent behavior across remote OpenAI API profiles,
# Claude, local Ollama, OpenRouter, or generic OpenAI-compatible providers.
PROVIDER_CAPABILITY_OVERRIDES="openrouter/z-ai/glm-5.3-flash=reasoning|tool_use"
PROVIDER_COST_TIERS="openrouter/z-ai/glm-5.3-flash=medium"
PROVIDER_LATENCY_TIERS="openrouter/z-ai/glm-5.3-flash=medium"
PROVIDER_TASK_CLASSES="openrouter/z-ai/*=general_reasoning"
PROVIDER_BUDGET_CLASSES="openrouter/z-ai/glm-5.3-flash=medium"

FALLBACK_MODEL=
FALLBACK_MODELS=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_API_BASE=
LLM_TARGET_COOLDOWN_SECONDS=300

LLM_LOG_ENABLED=true
LLM_LOG_CONTENT=false
LLM_LOG_DIR=/app/logs
LLM_LOG_MAX_BYTES=52428800
LLM_LOG_BACKUP_COUNT=5

# The managed local UI stack uses these loopback ports.  They are never bound
# to a LAN interface by manage.sh.
LOCAL_BACKEND_PORT=8004
LOCAL_FRONTEND_PORT=3001
VITE_API_URL=/api
VITE_WS_URL=/ws/chat
