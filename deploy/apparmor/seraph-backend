#include <tunables/global>

# Seraph backend container profile (#1103).
#
# Docker's docker-default template (moby profiles/apparmor/template.go) with
# exactly what the agent process sandbox (bubblewrap) needs:
#   - userns: create the sandbox's user namespace (AppArmor 4 / Ubuntu 23.10+
#     mediates this; on AppArmor 3 hosts delete the `userns,` line, which
#     those parsers do not know and whose kernels do not mediate it);
#   - mount, pivot_root (umount is already allowed): build the sandbox root.
#     The container holds no capabilities (compose cap_drop: [ALL]), so these
#     succeed only inside the sandbox's own user and mount namespaces;
#   - one /proc/sys write: bubblewrap --disable-userns sets
#     user/max_user_namespaces inside its own user namespace.
# docker-default's blanket `deny mount,` is removed; everything else is kept.
#
# Load once on the Docker host:  sudo apparmor_parser -r -W deploy/apparmor/seraph-backend
# Compose references it with:    security_opt: ["apparmor=seraph-backend"]

profile seraph-backend flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # bubblewrap (#1103)
  userns,
  mount,
  pivot_root,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=dockerd,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=seraph-backend,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  # docker-default denies every /proc/sys write outside kernel/shm*; the same
  # here, except user/max_user_namespaces (bubblewrap --disable-userns).
  deny @{PROC}/sys/{abi,crypto,debug,dev,fs,net,sunrpc,vm}/** w,
  deny @{PROC}/sys/user/max_{cgroup,fanotify,inotify,ipc,mnt,net,pid,time,uts}_* w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=seraph-backend,
}
