HOST_DATA_ROOT_DEV=./docker-data/dev

# Root directory for local canonical data and shared non-inference services.
SHARED_DATA_ROOT=./docker-data/shared

BACKEND_DATA_PATH_DEV=${HOST_DATA_ROOT_DEV}/backend/data
BACKEND_LOGS_PATH_DEV=${HOST_DATA_ROOT_DEV}/backend/logs

# Seraph AI settings
# Default provider profile: OpenRouter through LiteLLM's OpenAI-compatible path.
OPENROUTER_API_KEY=your-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_API_BASE=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/z-ai/glm-5.3-flash
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
AGENT_MAX_STEPS=10
DEBUG=true
WORKSPACE_DIR=/app/data
SANDBOX_URL=http://sandbox-dev:8060

# Authentication is disabled for the local development cockpit by default.
# To exercise the production-equivalent boundary, set DEPLOYMENT_ENVIRONMENT=test
# and OPERATOR_AUTH_ALLOW_UNAUTHENTICATED_TESTS=true only in test processes, or
# configure an OPERATOR_AUTH_SECRET_HASH as shown in env.prod.example.
DEPLOYMENT_ENVIRONMENT=development
OPERATOR_AUTH_SECRET_HASH=
OPERATOR_AUTH_COOKIE_SECURE=false
OPERATOR_AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
OPERATOR_AUTH_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
OPERATOR_AUTH_REVOCATION_POLL_SECONDS=2

# Epic #736/#775 phase: OpenRouter is the only active inference gateway.
# Keep the API key server-side. Provider/upstream policy and cloud consent are
# validated by the persisted model-fabric configuration; do not add local,
# direct-vendor, or arbitrary OpenAI-compatible fallbacks here.
OPENROUTER_PROVIDER_ONLY=true
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ALLOWED_UPSTREAMS=z-ai
OPENROUTER_ZERO_DATA_RETENTION=false
# Set a finite micro-USD ceiling through the authenticated settings surface.

# Optional persisted screen-analysis settings may select provider=openrouter
# and an exact vision-capable model. Capture consent and cloud-upload consent
# are separate; historical captures are never uploaded automatically.

# Screen-analysis budgets. 0 means unlimited for caps/size; retention is days.
SCREEN_ANALYSIS_MIN_SECONDS_BETWEEN_CAPTURES=0
SCREEN_ANALYSIS_MAX_DAILY_CAPTURES=0
SCREEN_CAPTURE_ARCHIVE_RETENTION_DAYS=365
SCREEN_CAPTURE_ARCHIVE_MAX_MB=0
SCREENSHOT_FOLDER_INGEST_ENABLED=true
SCREENSHOT_FOLDER_INGEST_INTERVAL_MIN=1
SCREENSHOT_FOLDER_INGEST_LIMIT=100
SCREENSHOT_FOLDER_ANALYSIS_LIMIT=100
SCREENSHOT_FOLDER_ANALYSIS_CONCURRENCY=2
SCREENSHOT_FOLDER_ANALYSIS_JOB_TIMEOUT_SECONDS=120

# Screenshot semantic analysis is opt-in and uses the governed OpenRouter
# vision adapter when the persisted cloud-upload permission is present.
SCREEN_ANALYSIS_PROVIDER=openrouter
# Optional: explicit OpenRouter-qualified vision model id.
# SCREEN_ANALYSIS_MODEL=openrouter/provider/model
RUNTIME_PROFILE_PREFERENCES="chat_agent=openrouter;onboarding_agent=openrouter;orchestrator_agent=openrouter;strategist_agent=openrouter;end_of_day_goal_report=openrouter;screenshot_observation_digest=openrouter"

# Local-screen end-of-day report. The report is stored in Seraph memory.
# Email delivery is off by default and, when enabled, still requires the
# preview gate to be deliberately disabled plus an allowlisted recipient.
END_OF_DAY_REPORT_ENABLED=true
END_OF_DAY_REPORT_HOUR=21
END_OF_DAY_REPORT_LLM_ENABLED=false
EMAIL_REPORTS_ENABLED=false
EMAIL_REPORTS_PREVIEW_REQUIRED=true
EMAIL_REPORTS_TO=
EMAIL_REPORTS_TO_ALLOWLIST=
EMAIL_REPORTS_FROM=
EMAIL_REPORTS_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Direct-vendor and generic OpenAI-compatible profiles are intentionally not
# active in this phase. Legacy environment values are reported as stale during
# migration instead of being selected silently.

# Capability, cost, latency, and budget tags steer operator routing and audit output.
# These tags are operator policy hints, not provider-parity claims.
PROVIDER_CAPABILITY_OVERRIDES="openrouter/z-ai/glm-5.3-flash=reasoning|tool_use"
PROVIDER_COST_TIERS="openrouter/z-ai/glm-5.3-flash=medium"
PROVIDER_LATENCY_TIERS="openrouter/z-ai/glm-5.3-flash=medium"
PROVIDER_BUDGET_CLASSES="openrouter/z-ai/glm-5.3-flash=medium"
RUNTIME_POLICY_REQUIREMENTS=
RUNTIME_POLICY_SCORES="chat_agent=reasoning:5|tool_use:4;session_title_generation=fast:5|cheap:3"
RUNTIME_MAX_COST_TIER="session_title_generation=low;mcp_*=medium"
RUNTIME_MAX_LATENCY_TIER="session_title_generation=low;mcp_*=medium"
RUNTIME_MAX_BUDGET_CLASS="session_title_generation=low;mcp_*=medium"
FALLBACK_MODEL=
FALLBACK_MODELS=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_API_BASE=
LLM_TARGET_COOLDOWN_SECONDS=300

# Frontend settings
VITE_API_URL=http://localhost:8004
VITE_WS_URL=ws://localhost:8004/ws/chat
